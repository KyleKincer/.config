            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock → Hyper (Ctrl+Shift+Option+Command)",
                        "manipulators": [
                            {
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_shift",
                                        "modifiers": ["left_command", "left_control", "left_option"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }],
                                "type": "basic"
                            }
                        ]
                    },
                    {
                        "description": "Hyper+1 → Dia (Browser)",
                        "manipulators": [
